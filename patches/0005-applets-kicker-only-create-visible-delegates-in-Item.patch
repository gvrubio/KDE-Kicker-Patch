From a59b489e7d86f0515cda6a78d551d5c72e67b102 Mon Sep 17 00:00:00 2001
From: gvrubio <gvidalrubio@gmail.com>
Date: Sun, 25 Oct 2026 13:09:57 +0100
Subject: [PATCH 5/5] applets/kicker: only create visible delegates in
 ItemMultiGridView

Each section of ItemMultiGridView is a GridView as tall as its content
inside the outer Flickable, so from the GridView's point of view all of
its items are visible and it creates a delegate for every one of them.
For search results in the dashboard this meant building hundreds of
delegates per keystroke, most of them scrolled out of view.

Use negative display margins to shrink the range each GridView fills to
the part of it that is inside the Flickable's viewport. The current item
is always created by GridView, so keyboard navigation and scrolling it
into view keep working.

Measured with qmlprofiler while typing in the dashboard: delegates
created per keystroke went from 112 to 59 on average (405 to 157 at
most), and keys queued behind a blocked UI from 25% to 3%.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 applets/kicker/ItemGridView.qml      | 2 ++
 applets/kicker/ItemMultiGridView.qml | 8 ++++++++
 2 files changed, 10 insertions(+)

diff --git a/applets/kicker/ItemGridView.qml b/applets/kicker/ItemGridView.qml
index d28eb3d661..f1307fd699 100644
--- a/applets/kicker/ItemGridView.qml
+++ b/applets/kicker/ItemGridView.qml
@@ -35,6 +35,8 @@ FocusScope {
     property alias cellWidth: gridView.cellWidth
     property alias cellHeight: gridView.cellHeight
     property alias iconSize: gridView.iconSize
+    property alias displayMarginBeginning: gridView.displayMarginBeginning
+    property alias displayMarginEnd: gridView.displayMarginEnd
 
     onFocusChanged: {
         if (!focus && !root.keyEventProxy.activeFocus) {
diff --git a/applets/kicker/ItemMultiGridView.qml b/applets/kicker/ItemMultiGridView.qml
index 69a61a6c47..9e9d7c6644 100644
--- a/applets/kicker/ItemMultiGridView.qml
+++ b/applets/kicker/ItemMultiGridView.qml
@@ -169,6 +169,14 @@ PlasmaComponents.ScrollView {
                         width: parent.width
                         height: Math.ceil(count / Math.floor(width / itemMultiGrid.cellSize)) * itemMultiGrid.cellSize
 
+                        // The grid is as tall as its content and scrolled by our Flickable, so on its
+                        // own it would create a delegate for every item, which makes search slow with
+                        // many results. Negative display margins limit it to the part scrolled into view.
+                        readonly property real visibleTop: Math.max(0, Math.min(height, flickable.contentY - gridDelegate.y - y))
+                        readonly property real visibleBottom: Math.max(0, Math.min(height, flickable.contentY + flickable.height - gridDelegate.y - y))
+                        displayMarginBeginning: -visibleTop
+                        displayMarginEnd: -(height - visibleBottom)
+
                         cellWidth: itemMultiGrid.cellSize
                         cellHeight: itemMultiGrid.cellSize
                         iconSize: itemMultiGrid.iconSize
